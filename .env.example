SECRET_KEY='change-me-to-a-long-random-secret'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
EMAIL_HOST='smtp.example.com'
EMAIL_HOST_USER='your-smtp-user'
EMAIL_HOST_PASSWORD='your-smtp-password'
EMAIL_PORT='2525'

# PostgreSQL dev DB (leave empty to fall back to SQLite)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Cloudflare R2 media storage (leave R2_BUCKET_NAME empty to use local files)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=hotel-menu-images
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com/hotel-menu-images
